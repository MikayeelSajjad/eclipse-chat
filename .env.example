# Local development (no Turso account needed):
TURSO_DATABASE_URL=file:data/eclipse.db

# Production on Vercel (from Turso dashboard):
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbG...

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
# Create two subscription products/variants (Nitro Basic $1.99, Nitro+ $4.99)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_BASIC_ID=
LEMONSQUEEZY_VARIANT_PLUS_ID=

# Webhook signing secret (Store → Webhooks → create endpoint → signing secret)
# URL: https://your-app.vercel.app/api/lemonsqueezy/webhook
# Events: subscription_created, subscription_updated, subscription_cancelled, subscription_expired
LEMONSQUEEZY_WEBHOOK_SECRET=

# Optional: used for checkout redirect URLs
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
